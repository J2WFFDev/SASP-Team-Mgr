    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.15",
    "postcss": "^8",
    "prisma": "^5.13.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.2",
    "typescript": "^5"
  }
}
