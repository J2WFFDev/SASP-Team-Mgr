generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL should be set to the non-pooled Neon connection string.
  // If not set, falls back to DATABASE_URL (set via build script).
  directUrl = env("DIRECT_URL")
}

enum ForecastStatus {
  DRAFT
  PRELIM
  ARBITRATION
  APPROVED
  PRODUCTION
}

model Event {
  id             String         @id @default(cuid())
  name           String         @unique
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  forecastStatus ForecastStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  flights             Flight[]
  stages              Stage[]
  squads              Squad[]
  athleteAssignments  AthleteAssignment[]
  staffAssignments    StaffAssignment[]
  commitmentStatuses  CommitmentStatus[]

  @@map("events")
}

model Flight {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  startTime   DateTime?
  flightOrder Int       @default(0)
  createdAt   DateTime  @default(now())

  athleteAssignments AthleteAssignment[]
  staffAssignments   StaffAssignment[]

  @@unique([eventId, name])
  @@map("flights")
}

model Stage {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  stageOrder Int @default(0)

  athleteAssignments AthleteAssignment[]

  @@unique([eventId, name])
  @@map("stages")
}

model Discipline {
  id        String  @id @default(cuid())
  name      String  @unique
  shortName String?
  gunType   String?

  athleteAssignments AthleteAssignment[]
  commitmentStatuses CommitmentStatus[]

  @@map("disciplines")
}

model Person {
  id         String       @id @default(cuid())
  fullName   String       @unique
  email      String?
  role       PersonRole   @default(ATHLETE)
  status     PersonStatus @default(ACTIVE)
  gender     String?
  team       String?
  teamId     String?
  teamRef    Team?        @relation(fields: [teamId], references: [id])
  division   String?
  classLabel String?

  athleteAssignments AthleteAssignment[]
  staffAssignments   StaffAssignment[]
  commitmentStatuses CommitmentStatus[]
  coachLinks         PersonLink[]        @relation("CoachLinks")
  athleteLinks       PersonLink[]        @relation("AthleteLinks")

  @@map("persons")
}

enum PersonRole {
  ATHLETE
  COACH
  RO
  VOLUNTEER
  STAFF
}

enum PersonStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}

enum UserRole {
  LEAGUE_ADMIN
  MATCH_DIRECTOR
  HEAD_COACH
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  shortName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  persons Person[]

  @@map("teams")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(HEAD_COACH)
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Squad {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  squadNum  Int
  squadName String?
  division  String?
  classLabel String?

  athleteAssignments AthleteAssignment[]

  @@unique([eventId, squadNum])
  @@map("squads")
}

model AthleteAssignment {
  id          String  @id @default(cuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  flightId    String
  flight      Flight  @relation(fields: [flightId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       Stage?  @relation(fields: [stageId], references: [id])
  personId    String
  person      Person  @relation(fields: [personId], references: [id])
  disciplineId String?
  discipline  Discipline? @relation(fields: [disciplineId], references: [id])
  squadId     String?
  squad       Squad?  @relation(fields: [squadId], references: [id])
  relay       Int?
  relayCode   String?
  shootOrder  Int?
  notes       String?
  createdAt   DateTime @default(now())

  @@map("athlete_assignments")
}

model StaffAssignment {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  flightId String
  flight   Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id])
  role     String?
  stageRef String?
  relay    Int?
  notes    String?
  createdAt DateTime @default(now())

  @@map("staff_assignments")
}

enum CommitmentStatusEnum {
  COMMITTED
  TENTATIVE
  DECLINED
  NO_RESPONSE
}

model CommitmentStatus {
  id           String               @id @default(cuid())
  eventId      String
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId     String
  person       Person               @relation(fields: [personId], references: [id])
  disciplineId String
  discipline   Discipline           @relation(fields: [disciplineId], references: [id])
  status       CommitmentStatusEnum @default(NO_RESPONSE)
  updatedAt    DateTime             @updatedAt

  @@unique([eventId, personId, disciplineId])
  @@map("commitment_statuses")
}

model PersonLink {
  id        String @id @default(cuid())
  coachId   String
  coach     Person @relation("CoachLinks", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   Person @relation("AthleteLinks", fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([coachId, athleteId])
  @@map("person_links")
}
